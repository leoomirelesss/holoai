{
  "name": "linde",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.21.0 || >=24.0.0"
  },
  "scripts": {
    "tokens": "node scripts/generate-design-tokens.mjs",
    "tokens:check": "node scripts/generate-design-tokens.mjs --check",
    "dev": "node scripts/next.mjs dev --hostname 0.0.0.0",
    "build": "npm run tokens:check && node scripts/next.mjs build",
    "start": "node scripts/next.mjs start --hostname 0.0.0.0",
    "typecheck": "node scripts/next.mjs typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test:e2e": "playwright test",
    "test:db": "node scripts/test-brand-data.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
